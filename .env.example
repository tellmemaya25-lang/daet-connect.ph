NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private Supabase Storage buckets
TOURS_OPERATOR_DOCUMENTS_BUCKET=tours-operator-documents
TOURS_GUIDE_SENSITIVE_BUCKET=tours-guide-sensitive-documents

# PayMongo (sandbox: use sk_test_ keys). Without PAYMONGO_SECRET_KEY the
# "Pay online" button is hidden and tourists pay by GCash/bank + receipt upload.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
# Secret returned when you register https://<your-domain>/api/webhooks/paymongo
# for the checkout_session.payment.paid event.
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret
# Optional, comma separated; must be enabled on your PayMongo account.
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,card
# Public URL used for PayMongo success/cancel redirects (falls back to VERCEL_URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs QR badges and booking tickets (server only, at least 32 characters).
# Generate one with: openssl rand -base64 48
# Changing it invalidates every QR already issued.
QR_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-chars
