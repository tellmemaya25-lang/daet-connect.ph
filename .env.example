NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private Supabase Storage buckets
TOURS_OPERATOR_DOCUMENTS_BUCKET=tours-operator-documents
TOURS_GUIDE_SENSITIVE_BUCKET=tours-guide-sensitive-documents

# PayMongo (sandbox: use sk_test_ keys). Without PAYMONGO_SECRET_KEY the
# "Pay online" button is hidden and tourists pay by GCash/bank + receipt upload.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
# Secret returned when you register https://<your-domain>/api/webhooks/paymongo
# for the checkout_session.payment.paid event.
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret
# Optional, comma separated; must be enabled on your PayMongo account.
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,card
# Public URL used for PayMongo success/cancel redirects (falls back to VERCEL_URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs QR badges and booking tickets (server only, at least 32 characters).
# Generate one with: openssl rand -base64 48
# Changing it invalidates every QR already issued.
QR_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Web Push (generate once: npx web-push generate-vapid-keys).
# The public key is sent to browsers; the private key stays on the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:tourism@daet.gov.ph
# Shared with the database (Vault secret tours_push_secret); at least 32 characters.
NOTIFICATIONS_PUSH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Google Maps (optional; without keys the site shows a sketch map and estimates).
# Server key: Routes API only. Browser key: Maps JavaScript API only, HTTP-referrer restricted.
GOOGLE_MAPS_SERVER_KEY=your-routes-api-key
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-maps-js-key
