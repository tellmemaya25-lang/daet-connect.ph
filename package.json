{
  "name": "daet-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:poll": "node scripts/dev-poll.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e:tours": "playwright test --config playwright.tours.config.ts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:kalmado": "node scripts/seed-kalmado.mjs",
    "paymongo:setup": "node scripts/paymongo-setup.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "6.14.0",
    "next": "^16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
